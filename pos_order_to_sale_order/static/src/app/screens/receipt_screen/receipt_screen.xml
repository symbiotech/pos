<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="pos_order_to_sale_order.ReceiptScreen"
        t-inherit="point_of_sale.ReceiptScreen"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//input[hasclass('send-receipt-email-input')]/parent::div"
            position="attributes"
        >
            <attribute name="t-if">canSendReceipt</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('sending-receipt-management')]/parent::div"
            position="attributes"
        >
            <attribute name="t-if">canSendReceipt</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('notice') and hasclass('text-center')]"
            position="attributes"
        >
            <attribute name="t-if">canSendReceipt</attribute>
        </xpath>
    </t>
</templates>
