<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_order_to_sale_order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Sale Order Creation" id="pos_create_sale_order">
                    <setting string="Create Draft Sale Orders">
                        <field name="pos_iface_create_draft_sale_order" />
                    </setting>

                    <setting string="Create Confirmed Sale Orders">
                        <field name="pos_iface_create_confirmed_sale_order" />
                    </setting>

                    <setting string="Create Delivered Sale Orders">
                        <field name="pos_iface_create_delivered_sale_order" />
                    </setting>

                    <setting string="Create Invoiced Sale Orders">
                        <field name="pos_iface_create_invoiced_sale_order" />
                    </setting>

                    <setting
                        string="Default Sale Order Creation"
                        help="When set to a specific state, Create Order creates that Sale Order immediately. Ask keeps the choice popup. Required (not Ask) when Customer Account Validate is enabled."
                    >
                        <field name="pos_iface_create_sale_order_default" />
                    </setting>

                    <setting
                        string="Create Sale Order on Customer Account Validate"
                        help="Pay fully with Customer Account and Validate to create a Sale Order in the Default state and show a receipt. No Point of Sale order is saved."
                    >
                        <field name="pos_iface_create_sale_order_on_validate" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
